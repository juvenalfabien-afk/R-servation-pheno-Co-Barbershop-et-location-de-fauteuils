# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=ton-mot-de-passe-fort-ici
# Génère-en une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=une-chaine-aleatoire-de-64-caracteres-minimum

# ── Email (Resend) — https://resend.com — Gratuit : 3 000 emails/mois ─────────
RESEND_API_KEY=re_xxxxxxxxxxxx
# Domaine vérifié dans Resend (ex : phenoandco.fr)
EMAIL_FROM=PHENO&CO <noreply@phenoandco.fr>

# ── Email admin (destinataire des notifications) ──────────────────────────────
NEXT_PUBLIC_ADMIN_EMAIL=location.phenoandco@gmail.com

# ── Site URL (pour les liens dans les emails) ─────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://phenoandco.fr

# ── SMS (Twilio) — https://twilio.com — Payant : ~0.06 €/SMS ─────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numéro Twilio au format E.164 (ex : +33XXXXXXXXX)
TWILIO_FROM_NUMBER=+33XXXXXXXXX

# ── Cron secret (pour protéger /api/cron/reminders) ──────────────────────────
# Génère-en une : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=une-chaine-secrete-pour-le-cron

# ── EmailJS (contact form backup — optionnel si Resend est configuré) ─────────
NEXT_PUBLIC_EMAILJS_KEY=ta-cle-publique-emailjs
