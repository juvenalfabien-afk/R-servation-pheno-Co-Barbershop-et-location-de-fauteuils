{
  "name": "phenoandco-next",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "prestart": "node scripts/validate-env.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:env": "node scripts/validate-env.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts"
  },
  "dependencies": {
    "@next/env": "15.5.28",
    "@supabase/postgrest-js": "2.107.0",
    "next": "15.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "typescript": "^5.8.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.5"
    }
  }
}
